{
  // The CHECKING config: covers every TypeScript file in the repo, emits nothing.
  //
  // This is also the one the editor picks up, which is the point. An earlier
  // version included only "src/**/*.ts", so `tsc --noEmit` reported success while
  // silently ignoring test/ and vitest.config.ts — the editor found real errors
  // the command line said did not exist.
  //
  // Building is a separate concern with a separate file: tsconfig.build.json.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "noEmit": true,

    "strict": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts"]
}
