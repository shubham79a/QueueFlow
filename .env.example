# Copy to .env. Every value here also has a default in code, so .env is optional.

# Redis — the transport. Host port 6379 is mapped by docker-compose.yml.
REDIS_URL=redis://127.0.0.1:6379

# Postgres — the record of what happened. Host port 5433, because 5432 is
# already in use on this machine; inside compose it is still 5432.
DATABASE_URL=postgres://queueflow:queueflow@127.0.0.1:5433/queueflow

# API port. 3000 is already in use on this machine.
PORT=4000

# Identifies this worker in logs, and in the job_effects rows it writes.
# Each worker process needs a distinct value once there is more than one.
WORKER_ID=w1
