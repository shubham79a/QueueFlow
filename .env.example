# Copy to .env. Every value here also has a default in code, so .env is optional.

# Redis — the transport. Host port 6379 is mapped by docker-compose.yml.
REDIS_URL=redis://127.0.0.1:6379

# Postgres — the record of what happened. Host port 5433, because 5432 is
# already in use on this machine; inside compose it is still 5432.
DATABASE_URL=postgres://queueflow:queueflow@127.0.0.1:5433/queueflow

# API port. 3000 is already in use on this machine.
PORT=4000

# Identifies this worker in logs, in the job_effects rows it writes, and — since
# reliable handoff — in the NAME OF THE REDIS KEY holding its in-flight jobs.
# Two processes sharing a value share that list and will fight over it.
# Each worker process needs a distinct value once there is more than one.
WORKER_ID=w1

# How many jobs ONE worker process may run at once.
# Helps for IO-bound work (timers, network) where the event loop is idle while
# waiting. Does nothing for CPU-bound work — that needs more worker processes.
# The Postgres pool is sized from this value, so raising it is safe.
CONCURRENCY=1

# Retry backoff. Delay before attempt N is 2^N * RETRY_BASE_MS, capped at
# RETRY_MAX_MS, plus up to 30% jitter. Tests override the base to run a full
# five-attempt cycle in under a second.
RETRY_BASE_MS=1000
RETRY_MAX_MS=60000

# --------------------------------------------------------------------------
# Failure detection.
# --------------------------------------------------------------------------

# How long a worker's "I am alive" key survives without a refresh, and how often
# the worker refreshes it.
#
# THE RATIO IS THE SETTING. The TTL must be a comfortable multiple of the
# interval, because a late beat is not proof of death — a garbage-collection
# pause or a slow moment on the connection will do it. At 30/10 a worker can
# miss two beats running and still not be declared dead.
#
# Set the TTL below the interval and every healthy worker is pronounced dead
# between beats, its jobs are taken away mid-flight, and they run twice. That is
# not a hypothetical: it is exactly what the crash test does on purpose, with
# HEARTBEAT_TTL_S=3, to make the duplicate visible.
HEARTBEAT_TTL_S=30
HEARTBEAT_INTERVAL_MS=10000

# How often the scheduler looks for dead workers and orphaned rows. Rarer than
# the retry check because both are answers to rare events and both cost more to
# ask. Recovery latency is dominated by HEARTBEAT_TTL_S regardless.
REAP_INTERVAL_MS=5000

# How old a 'queued' row must be before the sweep treats it as lost rather than
# as merely waiting its turn. MUST EXCEED NORMAL QUEUE WAIT — set this below the
# time jobs really spend in a backlog and the sweep will re-push ids that are
# already queued.
ORPHAN_AGE_S=60

# The lease check on every write-back: `on` (default) or `off`.
#
# On, a worker whose job was taken away by the reaper cannot record a result —
# it finds its lease has been reissued and abandons the write. Off, both workers
# record, and job_effects gets two rows for one job.
#
# It exists as a switch for exactly one reason: the crash test runs the same
# scenario both ways, so the duplicate can be SEEN rather than argued about.
# There is no reason to turn it off in normal use.
FENCING=on

# --------------------------------------------------------------------------
# Who may write.
# --------------------------------------------------------------------------

# Comma-separated API keys accepted on POST /api/jobs and POST /api/jobs/:id/replay.
# Reading is always open — the dashboard must be viewable without signing in.
#
# Generate one with `npm run key:new` and paste it here. Callers send it as:
#   Authorization: Bearer <key>
#
# LEAVING THIS EMPTY LEAVES THE WRITE ROUTES OPEN. That is deliberate so a fresh
# clone runs with no setup, and the API warns loudly at startup when it happens.
# Set it before deploying anywhere reachable: deliver_webhook means an open
# POST /api/jobs lets a stranger make this server send requests to any URL.
API_KEYS=

# The operator password. Unlocks the actions in the dashboard — Replay, and the
# submit form — by exchanging it for a session cookie. Reading never needs it.
#
# Stored in plain text on purpose: this is a deployment secret, like the password
# already inside DATABASE_URL, not a user record in a table. Hashing protects a
# password from whoever can read the database it lives in, and there is no such
# database here — anyone who can read this can read the whole file.
#
# Empty means login is off and the dashboard shows no Sign in button.
# Generate one with `npm run key:new`.
ADMIN_PASSWORD=

# Signs the session cookie. Without it a random value is generated at every boot,
# so every restart signs everyone out — and two API processes reject each other's
# cookies. The API warns at startup when it is missing.
# Generate one with `npm run key:new`.
SESSION_SECRET=
