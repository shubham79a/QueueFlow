{
  "name": "queueflow",
  "version": "0.1.0",
  "private": true,
  "description": "A distributed background job queue built on raw Redis primitives",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file=.env src/api/index.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker/index.ts",
    "dev:receiver": "tsx watch --env-file=.env src/receiver/index.ts",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:psql": "docker compose exec postgres psql -U queueflow -d queueflow",
    "typecheck": "tsc --noEmit",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "redis:cli": "docker compose exec redis redis-cli",
    "redis:monitor": "docker compose exec redis redis-cli monitor"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ioredis": "^5.4.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
